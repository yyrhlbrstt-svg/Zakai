{
  "name": "@zakai/mandate-sdk",
  "version": "0.1.0",
  "description": "Reference client and MCP server for the Zakai Mandate protocol: verify, decide, trust registry, and outcome prediction hooks.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yyrhlbrstt-svg/Zakai.git",
    "directory": "sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "bin": {
    "zakai-mandate-mcp": "./dist/mcp-bin.js",
    "zakai-mandate-ready": "./dist/ready-bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "QUICKSTART.md",
    "SAFETY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ready": "npm run build && node dist/ready-bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jose": "^5.9.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
