// Zakai data model.
//
// Money is stored as INTEGER agorot (1 ₪ = 100 agorot) everywhere, so the
// 18% success-fee arithmetic is exact and never touches floating point.
// The "proof of savings" and "authorization" tables are the trust core of the
// product and are designed to be append-only / not user-editable.

generator client {
  provider = "prisma-client-js"
}

// The Neon integration injects NEON_*-prefixed variables in both dev and
// production, so we read those directly instead of a hand-copied DATABASE_URL.
// `url` is the pooled (PgBouncer) endpoint used by the app at runtime;
// `directUrl` is the unpooled endpoint, which `prisma migrate` requires because
// migrations need a real session (advisory locks don't survive pooling).
datasource db {
  provider  = "postgresql"
  url       = env("NEON_DATABASE_URL")
  directUrl = env("NEON_DATABASE_URL_UNPOOLED")
}

enum Plan {
  FREE
  PRO
  MAX
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  // Product tier. Determines the success-fee rate, active-case allowance and
  // access to the recurring-charges scan. Billing collection is a later stage
  // (PSP); the tier itself is enforced in code from day one.
  plan            Plan      @default(FREE)
  planChangedAt   DateTime?
  // E.164 mobile (any country), e.g. +972501234567. The number the user's bills
  // are registered to; ownership verification sends a code here.
  phone           String
  // ISO-3166 alpha-2 country the user signed up from. Israel is the launch
  // market (active tools are IL-first); capturing country turns international
  // signups into a real demand signal for where to expand next.
  country         String    @default("IL")
  createdAt       DateTime  @default(now())
  /// When the person proved they control this address. Null until they do.
  /// Basic use never waits on it; privilege does.
  emailVerifiedAt DateTime?

  // Referrals. `referralCode` is the short, shareable code in this user's
  // invite link; a DB default keeps the NOT NULL/UNIQUE column safe if a row is
  // ever created without one. `referredById` is who invited this user (set once
  // at signup). `referralCreditAgorot` is unspent reward credit that reduces the
  // user's next success fee — we only ever forgo fee revenue, never pay cash.
  referralCode         String  @unique @default(cuid())
  referredById         String?
  referredBy           User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals            User[]  @relation("Referrals")
  referralCreditAgorot Int     @default(0)

  cases              Case[]
  phoneVerifications PhoneVerification[]
  referralRewards    ReferralReward[]    @relation("Referrer")
  referralRewardFor  ReferralReward?     @relation("ReferredUser")
  consents           Consent[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  pushSubscriptions  PushSubscription[]
  vigilProfile       UserProfile?
  vigilAlerts        VigilAlert[]
}

// Consent ledger (Privacy Protection Law, Amendment 13): a durable record of
// WHAT the user agreed to and WHEN. Append-only; revocation is a timestamp,
// never a delete — the history itself is the compliance artifact.
model Consent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // e.g. "terms_privacy_v1"
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// One reward per referred user, granted when that user's FIRST check documents
// a real saving. Append-only audit record; the credit itself lives on the
// referrer's User.referralCreditAgorot.
model ReferralReward {
  id               String   @id @default(cuid())
  referrerId       String
  referrer         User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId   String   @unique
  referredUser     User     @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  triggeringCaseId String
  amountAgorot     Int
  createdAt        DateTime @default(now())

  @@index([referrerId])
}

enum CaseStatus {
  ANALYZED // AI produced a recommendation
  APPROVED // user explicitly consented to the drafted request
  VERIFIED // ownership + authorization both confirmed
  SENT // outreach dispatched to provider
  SAVED // a saving was documented -> fee applies
  NO_SAVING // reply recorded, no saving -> no fee
  REVOKED // authorization revoked / case cancelled
}

model Case {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Which full-service vertical this case belongs to (rule-pack key). Defaults
  // to "telecom" — the one proven full-service vertical — so every existing and
  // current case is unchanged; new verticals set it explicitly.
  vertical         String @default("telecom")
  provider         String // counterparty key within the vertical (cellcom, hapoalim…)
  // Direct outreach address for a counterparty that is not a known company —
  // late-payment's counterparty is the user's own client, never in the
  // provider registry. Null for every registry-backed vertical, which keeps
  // resolving contact address from `provider` via providers.ts as before.
  counterpartyEmail String?
  planDescription  String @default("")
  // Family mode: an optional label for whom this check is run ("אמא", "אבא"…).
  // Empty = the account owner themselves. Purely a display grouping; the case
  // stays owned by, and scoped to, the userId — no extra access surface.
  beneficiaryLabel String @default("")

  // amounts in agorot
  amountOriginal Int // documented "before" amount, snapshotted at analysis time
  targetAmount   Int
  marketLow      Int?
  marketHigh     Int?

  strategy     String @default("") // one-sentence plan shown to the user
  draftMessage String @default("") // exact outreach text the user approves

  // Which stance the Strategy Engine chose for this case, and the seed it was
  // drawn with. Stored so "why was this customer's claim worded this way" is
  // answerable months later, and so the outcome can be attributed back to the
  // stance when the case closes. Null on cases opened before the engine.
  strategyVariant String?
  strategySeed    Int?

  status CaseStatus @default(ANALYZED)

  // trust timeline
  approvedAt          DateTime?
  ownershipVerifiedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  authorization Authorization?
  savingsProof  SavingsProof?
  fee           Fee?
  outbox        Outbox[]

  @@index([userId])
}

// SMS ownership verification: a hashed one-time code sent to the user's phone.
model PhoneVerification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId     String? // optional: which case this verification unlocks
  phone      String
  codeHash   String // sha-256 of the 6-digit code; never stored in the clear
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum AuthorizationStatus {
  ACTIVE
  REVOKED
}

// The power-of-attorney-style authorization document a provider can verify.
model Authorization {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Human-verifiable public code, e.g. ZK-7Q4K-2M9P. Unique per authorization.
  code String @unique

  principalName  String
  principalPhone String // E.164; shown masked on the public verify page
  principalEmail String // shown masked on the public verify page
  provider       String
  scope          String

  status    AuthorizationStatus @default(ACTIVE)
  issuedAt  DateTime            @default(now())
  revokedAt DateTime?
}

enum OutboxChannel {
  EMAIL
  SMS
}

enum OutboxStatus {
  QUEUED
  SENT
  FAILED
}

// Every outbound message (real send or dev log) is recorded here. In dev, with
// no SMTP/SMS provider configured, messages land here and nothing leaves.
model Outbox {
  id                String        @id @default(cuid())
  caseId            String?
  case              Case?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  channel           OutboxChannel
  toAddress         String
  subject           String?
  body              String
  status            OutboxStatus  @default(QUEUED)
  providerMessageId String?
  error             String?
  createdAt         DateTime      @default(now())
  sentAt            DateTime?

  @@index([caseId])
}

// Append-only proof of savings: the "before/after" the fee is computed from.
model SavingsProof {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  originalAmount Int // agorot, copied from Case at record time
  newAmount      Int // agorot
  savingMonthly  Int // agorot, = max(0, original - new)
  source         String   @default("manual") // how the new amount was obtained
  /// True when the person told us they were paid, rather than the pipeline
  /// documenting it from a provider reply.
  ///
  /// Both are real and they are not the same. A verified proof has a reply and
  /// a before/after behind it; a self-report has somebody's word. That
  /// difference decides two things and they are decided differently: it counts
  /// toward the person's own record and the public wall, and it never produces
  /// a chargeable Fee — eighteen percent of a number somebody typed is not a
  /// fee this company could defend if asked to.
  selfReported   Boolean  @default(false)
  recordedAt     DateTime @default(now())

  @@index([selfReported, recordedAt])
}

enum FeeStatus {
  PENDING // saving documented, fee owed, not yet collected
  WAIVED // no saving -> no fee
  PAID
}

model Fee {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  savingMonthly         Int // agorot
  rateBps               Int       @default(1800) // 18.00%
  // `amount` is the NET fee actually charged. Gross = round(saving*rate/10000);
  // `referralCreditApplied` is how much referral credit reduced it (>= 0), so
  // gross = amount + referralCreditApplied.
  amount                Int // agorot, net of referral credit
  referralCreditApplied Int       @default(0) // agorot
  status                FeeStatus @default(PENDING)
  createdAt             DateTime  @default(now())

  // Fee collection. `provider` is which PSP handled it (or "mock" until a real
  // one is configured); `providerRef` is the payment/transaction id it returned;
  // `paidAt` is when the fee was confirmed collected. All null until a payment
  // is initiated — the fee lifecycle is: PENDING -> (checkout) -> PAID.
  provider    String? // e.g. "mock" | "payplus" | "tranzila"
  providerRef String?
  paidAt      DateTime?
}

// Durable fixed-window rate limiting for auth/OTP endpoints. Serverless
// functions don't share memory, so the window counter lives in the database.
model RateLimit {
  key       String   @id // "<bucket>:<identifier>:<windowStart>"
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Product feedback — "what would you improve in Zakai?". Stored so the team
// can read real user suggestions and prioritise from them. Email is optional
// (only if the user wants a reply); `context` records which screen it came
// from. Not linked to a user account — a logged-out visitor can leave it too.
model Feedback {
  id        String   @id @default(cuid())
  message   String
  email     String? // optional, only if they want a reply
  context   String   @default("") // e.g. the path the widget was opened from
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Commissionable lead intake for the high-value verticals (construction
// defects, car diminished-value, mortgage insurance, tax, arnona…). Zakai
// captures the qualified lead and connects the user to a vetted professional /
// service, monetising via a success/referral fee when the claim succeeds — the
// standard model in these industries, and honest (we facilitate, we don't
// impersonate the professional). `vertical` is the source screen's key.
model Lead {
  id        String   @id @default(cuid())
  vertical  String // e.g. "construction-defects" | "car-value" | "business:mandate"
  name      String
  /// Consumer leads leave a phone; institutional ones leave an email instead.
  /// Optional on both so neither has to be faked to satisfy the other.
  phone     String   @default("")
  email     String   @default("")
  company   String   @default("")
  note      String   @default("")
  status    String   @default("new") // new | contacted | matched | won | closed
  userId    String? // set if a logged-in user submitted it
  createdAt DateTime @default(now())

  @@index([vertical, createdAt])
}

/**
 * One closed claim, reduced to what can be learned from without identifying
 * anyone. Deliberately NOT related to Case or User: this table is the
 * aggregate evidence base, and the moment it carries a foreign key to a person
 * it stops being publishable, shareable with an institution, or sellable to a
 * regulator without a privacy rewrite.
 */
model StrategyOutcome {
  id String @id @default(cuid())

  market       String // ISO-3166 alpha-2
  vertical     String // rule-pack key
  counterparty String // normalised provider key, never free text
  variantId    String

  paid           Boolean
  recoveredMinor Int // minor units; 0 when nothing came back
  days           Int // send -> resolution

  /// True when the person told us what happened, rather than the pipeline
  /// observing it. Both are real evidence and they are not the same evidence:
  /// a verified case has a provider reply and a documented saving behind it,
  /// a self-report has somebody's memory. Mixing them in one column that no
  /// reader distinguishes is how a dataset gets quietly poisoned, so the
  /// column exists and every reader has to decide.
  selfReported Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([market, vertical, counterparty])
  @@index([market, vertical])
  @@index([selfReported, createdAt])
}

/**
 * A single-use password-reset token.
 * Only the SHA-256 of the token is stored, never the token itself — the same
 * discipline PhoneVerification already uses. A leaked database must not hand
 * an attacker working reset links for every account in it.
 */
/// Proof that somebody controls the address they registered with.
///
/// Signup accepted any address without checking, so an account could be opened
/// on somebody else's email — including whichever address ADMIN_EMAIL names,
/// which would hand over a dashboard listing every lead's contact details.
///
/// Same discipline as PasswordReset: only the hash is stored, single use,
/// short-lived, and every outstanding token dies when one is consumed.
model EmailVerification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// A third-party agent permitted to have mandates issued on its behalf.
///
/// The whole "become the rail" thesis requires that other agents can issue.
/// Until this existed they could not: issuance was gated by one shared secret,
/// ours, so a rival consumer agent literally could not adopt the format even
/// if it wanted to — and every one that did adopt it would have been
/// indistinguishable from us in the resulting token.
///
/// Two paths exist and this is the smaller one. An agent that runs its own key
/// infrastructure belongs in the trust registry with its own JWKS and needs no
/// API from us at all; that is the real issuer path and the one that scales.
/// This is for agents that do not want to run cryptography, and it comes with
/// a hard condition: the mandate says so. `zkm.on_behalf_of` names the agent,
/// because a token that hid the delegation would mean this company vouching
/// for a user verification it never performed.
model DelegatedIssuer {
  id            String    @id @default(cuid())
  /// Stable public identifier, e.g. "agent.example". Appears in the mandate.
  slug          String    @unique
  name          String
  /// SHA-256 of the API key. Never the key: a leaked table must not hand
  /// somebody the ability to issue authority in other people's names.
  keyHash       String    @unique
  /// The scopes this agent may request. Always a subset of the protocol's, and
  /// enforced at issuance — an issuer that could exceed its grant by asking is
  /// not constrained, it is merely trusted.
  allowedScopes String[]
  /// active | suspended. Suspension is immediate and needs no key rotation.
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?

  @@index([status])
}

/// The self-serve front door to DelegatedIssuer. Before this existed, becoming
/// a delegated issuer required finding a human and emailing them — the exact
/// "push" failure mode this protocol is supposed to avoid. This lets a third
/// party do everything itself: propose a slug, request scopes, submit. A human
/// still reviews before a real key is minted (admission to a trust boundary is
/// not something that should ever be fully automatic), but the applicant never
/// has to locate that human first.
model DelegationApplication {
  id               String   @id @default(cuid())
  /// Proposed, not yet reserved — uniqueness against DelegatedIssuer is
  /// enforced at approval time, not here, so two applicants proposing the same
  /// name is a normal event, not a race to fail loudly over.
  slug             String
  name             String
  contactEmail     String
  useCase          String
  /// Validated against the real scope catalogue at submission time — an
  /// applicant learns immediately if a requested scope doesn't exist or is
  /// categorically forbidden, rather than waiting days for a human to say so.
  requestedScopes  String[]
  status           String   @default("pending") // pending | approved | rejected
  reviewNote       String   @default("")
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
}

model PasswordReset {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/**
 * Revocation list for machine-verifiable Mandates (Ed25519 JWS).
 * Institutions verify the signature offline against JWKS, then call
 * GET /api/mandate/status/[jti] for recency. A signature cannot be un-signed;
 * this table is the withdraw mechanism. Append-only: never delete a row.
 * No user FK — the jti is the only handle an institution needs, and keeping
 * this table free of person identifiers keeps the status endpoint boring to
 * a bank security review.
 */
model MandateRevocation {
  jti          String   @id
  revokedAt    DateTime @default(now())
  /**
   * Position in the signed status list. Assigned at issue time, so a mandate
   * can be revoked by flipping one bit rather than by growing a list every
   * institution has to download in full.
   */
  statusIndex  Int?     @unique
  reason       String   @default("user_request")
  // Optional opaque audit tag (case id, operator id) — not returned publicly.
  internalNote String   @default("")

  @@index([revokedAt])
}

/**
 * Web Push subscription for the installed PWA.
 * endpoint is unique across the table so a device re-subscribe upserts cleanly.
 * Keys (p256dh / auth) are the browser-generated encryption material — never
 * log them in plaintext outside this table.
 */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

/**
 * One decision the self-improvement engine made, and what came of it.
 * PII-free by construction, exactly like StrategyOutcome: an experiment ledger
 * that carries a user id stops being publishable and starts being a liability.
 */
model ExperimentTrial {
  id           String   @id @default(cuid())
  experimentId String
  armId        String
  /**
   * Did this decision lead to the outcome the experiment is optimising for.
   */
  converted    Boolean  @default(false)
  /**
   * Target metric value for this trial.
   */
  value        Float    @default(0)
  /**
   * Guardrail metric readings, keyed by metric.
   */
  guardrails   Json?
  createdAt    DateTime @default(now())

  @@index([experimentId, armId])
  @@index([experimentId, createdAt])
}

/**
 * Append-only, never updated in place. A promotion is a change the machine made
 * to the product without asking anyone, so the history of those changes has to
 * survive the next one — both to roll back and to answer "when did it start
 * behaving like this, and on what evidence".
 */
model ExperimentPromotion {
  id           String    @id @default(cuid())
  experimentId String
  armId        String
  relativeLift Float
  samples      Int
  /**
   * Plain-language reason, as shown in the weekly digest.
   */
  explanation  String
  /**
   * Set when a human or a later regression reverted this.
   */
  revertedAt   DateTime?
  promotedAt   DateTime  @default(now())

  @@index([experimentId, promotedAt])
}

/**
 * The profile, mirrored to the account so the server can act while the person
 * is not looking.
 * The device copy stays authoritative and stays the only copy until there is an
 * account — a profile that requires signup puts a wall in front of the first
 * useful thing the product does, and the most sensitive answers here
 * (disability, low income, immigration status) should not leave a phone on our
 * say-so. But a watchdog that only runs while its owner has the app open is not
 * a watchdog, so once someone has chosen to have an account, this is what the
 * Vigil reads.
 */
model UserProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * The RightsProfile as stored on the device.
   */
  data      Json
  updatedAt DateTime @updatedAt
}

/**
 * One alert we have already sent, so we never send it twice.
 * Without this the daily cron re-notifies about the same deadline every morning
 * until it passes, which is how a genuinely useful alert becomes the reason
 * somebody turns notifications off — and the right to interrupt, once spent,
 * does not come back.
 */
model VigilAlert {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * rightId plus the tax year when there is one, so each deadline alerts once.
   */
  alertKey String
  sentAt   DateTime @default(now())

  @@unique([userId, alertKey])
  @@index([userId, sentAt])
}
