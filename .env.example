# --- Database ---
DATABASE_URL="postgresql://zakai@localhost:5433/zakai_dev?schema=public"

# --- Auth ---
# 32+ char secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET="dev-only-insecure-secret-change-me-please-32chars-min"

# --- AI (Anthropic) ---
# Server-side only. Never exposed to the browser.
# When unset, analysis/drafting endpoints return a clear "AI unavailable" error
# rather than fabricating results.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Outbound email (outreach + notifications) ---
# When SMTP is unconfigured, messages are written to the Outbox table only
# (dev mode) and nothing leaves the system.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Zakai <yyrhlbrstt@gmail.com>"

# --- ZML / external packs CDN ---
ZML_ENGINE_VERSION=1.0.0
ZML_PACKS_CDN=https://packs.zakai.io
# ZML_PACKS_LOCAL=/absolute/path/to/zakai-packs
ZAKAI_ADMIN_TOKEN=
# ZAKAI_WIDGET_KEYS_JSON={"pk_live_xxx":"yourdomain.com"}
# Shared secret for POST /api/inbound-email. When set, requests must send
# header X-Inbound-Secret. Wire via Forward Email / Cloudflare Email Workers.
INBOUND_EMAIL_SECRET=""
# Address shown to users on SENT cases — "forward the provider reply here".
NEXT_PUBLIC_PROOFS_EMAIL="proofs@zakai.app"
PROOFS_INBOUND_EMAIL="proofs@zakai.app"

# --- SMS (ownership verification) ---
# When unset, the code is written to the Outbox only (dev mode) so the flow is
# fully testable without a real SMS provider.
SMS_PROVIDER="dev"          # dev | http
SMS_HTTP_URL=""             # generic HTTP SMS gateway endpoint
SMS_HTTP_TOKEN=""

# --- Web Push (PWA notifications) ---
# Generate once: npx web-push generate-vapid-keys
# Public key is also needed in the browser (NEXT_PUBLIC_…).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:yyrhlbrstt@gmail.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- App ---
# Public base URL, used to build authorization-document verification links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Contact addresses shown on the Trust/Security page, footer, and in fee emails.
# `.example` domains are RFC 2606 placeholders — the app never shows them to users
# (see src/lib/contact.ts); unset or use a real inbox before production.
NEXT_PUBLIC_SECURITY_EMAIL="yyrhlbrstt@gmail.com"
NEXT_PUBLIC_SUPPORT_EMAIL="yyrhlbrstt@gmail.com"
LEADS_EMAIL="yyrhlbrstt@gmail.com"
FEEDBACK_EMAIL="yyrhlbrstt@gmail.com"
SALES_EMAIL="yyrhlbrstt@gmail.com"

# --- Error monitoring (optional) ---
# When set (and @sentry/nextjs is installed) errors are forwarded to Sentry.
# When unset, errors are still logged to the host's Logs (Vercel).
SENTRY_DSN=""

# --- Payments (PSP). Mock by default; set to "payplus" for real collection. ---
PAYMENT_PROVIDER=mock
# PayPlus (payplus.co.il) — fill from the dashboard, verify in sandbox first.
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=
PAYPLUS_BASE_URL=https://restapi.payplus.co.il/api/v1.0

# --- The Oracle (claim outcome prediction) ---------------------------------
# Closed unless set. A pricing API that defaults to public because someone
# forgot a variable is a data leak with a countdown on it.
ORACLE_API_KEY=

# --- Mandate signing -------------------------------------------------------
# Required for /api/mandate/revocations to serve a signed status list. Absent,
# the endpoint 503s rather than serving an unsigned one: a consumer that cannot
# verify the signature would either reject it (fine) or trust it (fatal).
MANDATE_SIGNING_KID=zakai-2026-1
MANDATE_SIGNING_JWK=
MANDATE_ISSUER=https://zakai-3uxj.vercel.app

# --- Cron authentication ----------------------------------------------------
# Bearer token every /api/cron/* endpoint requires in production (fail-closed:
# without it they return 503 rather than run for anyone on the internet).
# Vercel sends it automatically on each cron invocation once the env var is
# set. Generate with: openssl rand -hex 32
# JSON map of airline name substring → contact email for flight cases (optional).
# Example: {"el al":"customerservice@elal.co.il"}
AIRLINE_CONTACT_OVERRIDES=

