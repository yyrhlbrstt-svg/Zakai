{
  "name": "zakai",
  "version": "1.2.2",
  "private": true,
  "description": "Zakai — the standard consumer money agent + Mandate infrastructure. Dual-track: recovery loop and institutional authority layer.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/prebuild-migrate.mjs && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:pack-labels": "tsx scripts/generate-pack-labels.mjs && git diff --exit-code src/lib/global/packLabels.generated.ts",
    "release-gate": "tsx scripts/release-gate.ts",
    "preflight": "node scripts/preflight.mjs",
    "verify:loop": "node scripts/verify-loop.mjs",
    "verify:interop": "node scripts/verify-interop.mjs",
    "verify:interop-external": "node scripts/verify-interop-external.mjs",
    "verify:packs-cdn": "node scripts/verify-packs-cdn.mjs",
    "verify:monopoly": "node scripts/verify-monopoly-surface.mjs",
    "verify:public-surface": "node scripts/verify-public-surface.mjs",
    "generate:pack-labels": "tsx scripts/generate-pack-labels.mjs",
    "sync:zml-he": "node scripts/sync-zml-hebrew-from-rights.mjs",
    "packs:validate": "cd zakai-packs && npm ci && npm run validate",
    "packs:publish:dry": "cd zakai-packs && npm run publish",
    "packs:export": "bash scripts/export-zakai-packs-repo.sh",
    "packs:sync": "tsx scripts/sync-zakai-packs-from-registry.mjs",
    "packs:release-check": "npm run packs:sync && npm run verify:packs-cdn",
    "gravity:checklist": "node scripts/gravity-checklist.mjs",
    "delegation:admit-pilot": "node scripts/admit-delegated-pilot.mjs",
    "grant:owner-access": "node scripts/grant-owner-access.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "verify:routes": "node scripts/routeSweep.mjs",
    "a11y": "node scripts/a11ySweep.mjs",
    "verify:flows": "node scripts/flowSweep.mjs",
    "verify:first-screen": "node scripts/verify-first-screen.mjs",
    "verify:idor": "node scripts/verify-idor.mjs",
    "mail:check": "node scripts/mail-check.mjs",
    "verify:agent-auth": "node scripts/verify-agent-authorization.mjs",
    "verify:money-loop": "node scripts/verify-money-loop.mjs",
    "verify:journey": "node scripts/verify-journey.mjs",
    "dev:smtp-sink": "node scripts/dev-smtp-sink.mjs",
    "verify:open-banking": "node scripts/verify-open-banking.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^1.26.0",
    "next": "^16.3.1",
    "next-intl": "^4.13.6",
    "nodemailer": "^9.0.5",
    "prisma": "6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "prisma": "6.19.3",
    "@prisma/client": "6.19.3"
  },
  "engines": {
    "node": ">=20"
  }
}
