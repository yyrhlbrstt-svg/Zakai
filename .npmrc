# Inngest declares OPTIONAL peer dependencies for every framework it supports,
# including @sveltejs/kit — which pulls vite 8, while vitest 2.1.9 pins vite 5.
# This is a Next.js app: the SvelteKit adapter is dead weight we never import,
# and the conflict it creates is not a real one. Upgrading vitest to satisfy a
# framework we do not use would put 3,000 passing tests at risk to please a
# peer range nothing in this repo reads.
legacy-peer-deps=true
