{
  "openapi": "3.1.0",
  "info": {
    "title": "Zakai Rights Protocol API",
    "version": "2026-08-01",
    "description": "Public API for consumer rights discovery. Catalog access requires no PII.",
    "contact": { "name": "Zakai Protocol", "url": "https://zakai-3uxj.vercel.app" }
  },
  "servers": [{ "url": "/api", "description": "Same origin as the Zakai deployment" }],
  "paths": {
    "/markets": {
      "get": {
        "operationId": "listMarkets",
        "summary": "Supported Zakai markets (engine + ZML catalog)",
        "tags": ["Discovery"],
        "responses": {
          "200": {
            "description": "Market list with catalog links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "markets": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rights/catalog": {
      "get": {
        "operationId": "listRightsCatalog",
        "summary": "List available rights by market",
        "tags": ["Catalog"],
        "parameters": [
          {
            "name": "market",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Z]{2}$", "example": "IL" }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "telecom",
                "energy",
                "finance",
                "transport",
                "insurance",
                "tax",
                "housing",
                "employment",
                "consumer_protection",
                "health",
                "education"
              ]
            }
          },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "zml_version", "in": "query", "schema": { "type": "string", "default": "1.0.0" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated catalog",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CatalogResponse" }
              }
            }
          },
          "404": { "description": "Unknown market" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/rights/catalog/{id}": {
      "get": {
        "operationId": "getRightById",
        "summary": "Get a right summary or full ZML document",
        "tags": ["Catalog"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "full", "in": "query", "schema": { "type": "boolean", "default": false } }
        ],
        "responses": {
          "200": { "description": "Right" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/rights/evaluate/{id}": {
      "get": {
        "operationId": "getEvaluationGuide",
        "summary": "Evaluation field guide (no server-side PII)",
        "tags": ["Evaluation"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Guide",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EvaluationGuide" }
              }
            }
          }
        }
      }
    },
    "/fairness/scores": {
      "get": {
        "operationId": "listFairnessScores",
        "summary": "De-identified provider win rates (0–100) from StrategyOutcome",
        "tags": ["Fairness"],
        "parameters": [
          {
            "name": "market",
            "in": "query",
            "schema": { "type": "string", "default": "IL", "pattern": "^[A-Z]{2}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Scores (empty until MIN_SAMPLE observations per provider)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FairnessScoresResponse" }
              }
            }
          },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/widget/validate": {
      "get": {
        "operationId": "validateWidgetKey",
        "summary": "Validate partner widget API key for Origin",
        "tags": ["Widget"],
        "parameters": [],
        "responses": {
          "200": { "description": "Valid key" },
          "403": { "description": "Invalid or missing key" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogResponse": {
        "type": "object",
        "required": ["zml_version", "api_version", "market", "total", "rights"],
        "properties": {
          "zml_version": { "type": "string" },
          "api_version": { "type": "string" },
          "market": { "type": "string" },
          "total": { "type": "integer" },
          "rights": { "type": "array", "items": { "$ref": "#/components/schemas/RightSummary" } }
        }
      },
      "RightSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "display_name": { "type": "object", "additionalProperties": { "type": "string" } },
          "category": { "type": "string" },
          "auto_eligible": { "type": "boolean" }
        }
      },
      "EvaluationGuide": {
        "type": "object",
        "required": ["right_id", "required_fields", "predicate_structure"],
        "properties": {
          "right_id": { "type": "string" },
          "required_fields": { "type": "array", "items": { "type": "object" } },
          "predicate_structure": { "type": "object" },
          "requires_human_gate": { "type": "boolean" }
        }
      },
      "FairnessScoresResponse": {
        "type": "object",
        "required": ["market", "min_observations", "providers", "disclaimer"],
        "properties": {
          "market": { "type": "string" },
          "min_observations": { "type": "integer" },
          "disclaimer": { "type": "string" },
          "providers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FairnessProviderScore" }
          },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "FairnessProviderScore": {
        "type": "object",
        "properties": {
          "provider": { "type": "string" },
          "fairnessScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "observations": { "type": "integer" },
          "wins": { "type": "integer" },
          "methodology": { "type": "string", "enum": ["strategy_outcome_win_rate"] }
        }
      }
    }
  }
}
